# Optional: you can also configure all of this from the Settings panel in the
# UI once "cowork serve" is running (it writes back to this same file).

DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.3
DEEPSEEK_MAX_TOKENS=4096

# Optional tuning
PLANNER_MAX_STEPS=12
SWARM_MAX_STEPS=15
SWARM_CONCURRENCY=4
